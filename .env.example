# Axevro contact mail credentials
# --------------------------------
# LOCAL: copy to .env.local and fill values (gitignored).
# PRODUCTION (Vercel): Project → Settings → Environment Variables
#   Add at least:
#     GMAIL_USER=axevro9@gmail.com
#     GMAIL_APP_PASSWORD=your_16_char_app_password
#     CONTACT_INBOX=axevro9@gmail.com
#   Then Redeploy. Without these, a secure fallback still delivers
#   to CONTACT_INBOX, but Gmail App Password is preferred.
#
# Option A — Gmail App Password (recommended now):
GMAIL_USER=axevro9@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option B — Brevo with your own domain (best long-term):
#   1) Use axevro.in
#   2) Brevo → Domains → authenticate SPF/DKIM/DMARC
#   3) Send from hello@axevro.in
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=b4bf9d001@smtp-brevo.com
BREVO_SMTP_PASS=your_smtp_key_xsmtpsib_here
BREVO_SENDER_EMAIL=b4bf9d001@smtp-brevo.com
BREVO_SENDER_NAME=Axevro
CONTACT_INBOX=axevro9@gmail.com
COMPANY_NAME=Axevro

# Optional: BREVO_API_KEY=xkeysib-xxxxxxxx
