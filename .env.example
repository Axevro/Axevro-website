# Axevro contact mail credentials
# --------------------------------
# LOCAL: copy values into .env.local (gitignored).
#
# PRODUCTION (required for Android / live site):
#   Vercel → Project → Settings → Environment Variables
#   Add for Production + Preview, then Redeploy:
#     GMAIL_USER=axevro9@gmail.com
#     GMAIL_APP_PASSWORD=your_16_char_app_password
#     CONTACT_INBOX=axevro9@gmail.com
#     COMPANY_NAME=Axevro
#
# Verify after deploy:
#   GET https://YOUR-APP.vercel.app/api/contact
#   Expect: "primaryTransport": true
#
# Without these vars, the form will NOT fake success — users see a clear error.

GMAIL_USER=axevro9@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=b4bf9d001@smtp-brevo.com
BREVO_SMTP_PASS=your_smtp_key_xsmtpsib_here
BREVO_SENDER_EMAIL=b4bf9d001@smtp-brevo.com
BREVO_SENDER_NAME=Axevro
CONTACT_INBOX=axevro9@gmail.com
COMPANY_NAME=Axevro
