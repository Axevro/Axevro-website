# Axevro contact mail credentials
# --------------------------------
# Problem: Brevo + @gmail.com sender fails Google/Yahoo/Microsoft checks
# ("Freemail domain is not recommended" in Brevo Senders).
#
# Option A — Gmail App Password (best while using Gmail):
#   Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=axevro9@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option B — Brevo with your own domain (best long-term):
#   1) Buy/use axevro.in
#   2) Brevo → Domains → authenticate SPF/DKIM/DMARC
#   3) Send from hello@axevro.in
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=b4bf9d001@smtp-brevo.com
BREVO_SMTP_PASS=your_smtp_key_xsmtpsib_here
BREVO_SENDER_EMAIL=b4bf9d001@smtp-brevo.com
BREVO_SENDER_NAME=Axevro
CONTACT_INBOX=axevro9@gmail.com
COMPANY_NAME=Axevro

# Optional: BREVO_API_KEY=xkeysib-xxxxxxxx
